{
  "name": "markdrop",
  "displayName": "Markdrop Sync",
  "description": "Publish and two-way sync Markdown, HTML and other text files with markdrop.in \u2014 save locally to push, edit on the web to pull back.",
  "version": "0.3.0",
  "publisher": "HimanshuKukreja",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "artifact",
    "html",
    "markdown",
    "markdrop",
    "publish",
    "share",
    "sync"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/himanshkukreja/markdrop.git"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onUri",
    "onLanguage:markdown",
    "onLanguage:html",
    "onLanguage:plaintext",
    "onLanguage:json",
    "onLanguage:xml",
    "onLanguage:csv"
  ],
  "contributes": {
    "commands": [
      {
        "command": "markdrop.signIn",
        "title": "Markdrop: Sign in"
      },
      {
        "command": "markdrop.signInWithToken",
        "title": "Markdrop: Sign in with API token"
      },
      {
        "command": "markdrop.signOut",
        "title": "Markdrop: Sign out"
      },
      {
        "command": "markdrop.publish",
        "title": "Markdrop: Publish / link current file"
      },
      {
        "command": "markdrop.syncNow",
        "title": "Markdrop: Sync now (push)"
      },
      {
        "command": "markdrop.openInBrowser",
        "title": "Markdrop: Open current document in browser"
      },
      {
        "command": "markdrop.unlink",
        "title": "Markdrop: Unlink current file"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "markdrop.publish",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Markdrop",
      "properties": {
        "markdrop.apiUrl": {
          "type": "string",
          "default": "https://api.markdrop.in",
          "description": "Markdrop API base URL."
        },
        "markdrop.webUrl": {
          "type": "string",
          "default": "https://markdrop.in",
          "description": "Markdrop web base URL."
        },
        "markdrop.pushOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically push linked documents to Markdrop when you save."
        },
        "markdrop.autoPull": {
          "type": "boolean",
          "default": true,
          "description": "Automatically pull remote changes into the local file (two-way sync)."
        },
        "markdrop.pollSeconds": {
          "type": "number",
          "default": 10,
          "minimum": 5,
          "description": "How often (seconds) to check Markdrop for remote changes on the active file."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.7.0"
  }
}
