# Copy this file to .env and fill in your values
# ---------------------------------------------------

# MONGODB — paste your connection string here
# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MARKDROP_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MARKDROP_MONGODB_DB=markdrop

# REDIS — Redis running on localhost (same machine)
# Local dev: brew install redis && brew services start redis
# EC2 prod:  sudo apt install redis-server && sudo systemctl enable redis-server
MARKDROP_REDIS_URL=redis://localhost:6379

# DEBUG — set to false on EC2
MARKDROP_DEBUG=true

# CORS — production: set to https://markdrop.in
MARKDROP_CORS_ORIGINS=["http://localhost:3000"]

# GOOGLE OAUTH — used for login AND the Google Docs integration.
# Create an OAuth client at https://console.cloud.google.com (Credentials).
MARKDROP_GOOGLE_CLIENT_ID=
MARKDROP_GOOGLE_CLIENT_SECRET=
# Login callback (identity only):
MARKDROP_GOOGLE_REDIRECT_URI=https://api.markdrop.in/api/v1/auth/google/callback

# GOOGLE DOCS INTEGRATION (opt-in export/sync)
# Register this SECOND redirect URI in the same OAuth client, and add the
# scope https://www.googleapis.com/auth/drive.file on the OAuth consent screen.
MARKDROP_GOOGLE_DOCS_REDIRECT_URI=https://api.markdrop.in/api/v1/google/callback
# Fernet key that encrypts stored Google refresh tokens at rest. REQUIRED for
# the Google Docs feature. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MARKDROP_TOKEN_ENCRYPTION_KEY=

# ── Artifacts (HTML / PDF / spreadsheet hosting on Cloudflare R2) ─────────────
# The artifact origin MUST be a separate registrable domain from the frontend.
# User-authored HTML served from markdrop.in could read the session token out of
# localStorage; a separate origin makes the same-origin policy prevent that.
MARKDROP_R2_ACCOUNT_ID=
MARKDROP_R2_ACCESS_KEY_ID=
MARKDROP_R2_SECRET_ACCESS_KEY=
MARKDROP_R2_BUCKET=markdrop-artifacts
# Start free: the Worker's own *.workers.dev host is a Public Suffix List entry,
# so it counts as a SEPARATE SITE (isolated cookies + independent domain
# reputation) at no cost. Swap in a bought domain later — artifact URLs are
# derived from this value at read time, never stored, so the switch is one edit.
MARKDROP_ARTIFACT_ORIGIN=https://markdrop-artifacts.<account>.workers.dev
# Only if you deliberately choose a subdomain of the app (weaker: shares domain
# reputation with markdrop.in, so phishing there can get the product flagged).
MARKDROP_ARTIFACT_ALLOW_SUBDOMAIN_ORIGIN=false
# HMAC key for short-lived private-artifact tokens (must match the Worker's).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
MARKDROP_ARTIFACT_SIGNING_KEY=

# ── Email ────────────────────────────────────────────────────────────────────
MARKDROP_RESEND_API_KEY=
MARKDROP_EMAIL_FROM=login@markdrop.in
MARKDROP_EMAIL_FROM_NAME=Markdrop
# Where replies land. The From addresses above are send-only mailboxes with no
# inbox, so without this a reply is silently dropped.
MARKDROP_EMAIL_REPLY_TO=kukreja.him@gmail.com
