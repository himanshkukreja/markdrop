{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://markdrop.in",
          "https://www.markdrop.in",
          "http://localhost:3000"
        ],
        "methods": ["PUT", "GET", "HEAD"],
        "headers": ["content-type"]
      },
      "exposeHeaders": ["ETag"],
      "maxAgeSeconds": 3600
    }
  ]
}
