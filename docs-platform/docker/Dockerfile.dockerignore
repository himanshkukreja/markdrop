!docs-platform/
frontend/node_modules
frontend/.next
frontend/.next-*
frontend/e2e
frontend/.env*
frontend/public/docs-assets
frontend/content/docs/video-scenes
docs-platform/node_modules
docs-platform/edge/dist
**/.DS_Store
