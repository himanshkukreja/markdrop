    "askPlaceholder": "Ask anything, like “how do I put my workspace on my own domain?”",
    "install": {
      "title": "Install the CLI",
      "sync": "os",
      "commands": {
        "macOS": "brew install himanshkukreja/tap/markdrop",
        "Windows": "irm https://github.com/himanshkukreja/markdrop/releases/latest/download/install.ps1 | iex",
        "Linux": "curl -fsSL https://github.com/himanshkukreja/markdrop/releases/latest/download/install.sh | sh"
      },
      "note": "Then `markdrop login` and `markdrop upload deck.pdf`. Your choice of system is remembered on every page.",
      "href": "/cli/install"
    },
    "ai": {
      "title": "These docs work for your AI too",
      "body": "Every page has a Markdown version at the same address plus `.md`, and the whole site is in `/llms.txt`. Copy page hands any page to your assistant, with a link it can fetch.",
      "links": [
        {
          "label": "llms.txt",
          "href": "/llms.txt"
        },
        {
          "label": "Copy a page for your assistant",
          "href": "/ai/use-these-docs"
        },
        {
          "label": "Connect Markdrop to your assistant",
          "href": "/ai/overview"
        }
      ]
    }
