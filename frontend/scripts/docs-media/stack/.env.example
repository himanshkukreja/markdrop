# Sandbox API settings for the docs media stack. LOCAL-ONLY values: nothing here is a real
# credential, and run_api.py refuses to start if Mongo, the API or the frontend point anywhere
# but this machine. stack.sh copies this file to stack/.env on first start; run_api.py runs
# with cwd = this folder, so backend/.env is never read.
#
# Parsed by run_api.py (not shell-sourced): KEY=VALUE per line, optional surrounding quotes.

MARKDROP_MONGODB_URI=mongodb://127.0.0.1:27019
MARKDROP_MONGODB_DB=markdrop_docs_demo
# In-process limiter storage; run_api.py also turns rate limiting off.
MARKDROP_REDIS_URL=memory://

MARKDROP_FRONTEND_URL=http://localhost:3400
MARKDROP_API_BASE_URL=http://127.0.0.1:8180
MARKDROP_CORS_ORIGINS=["http://localhost:3400","http://127.0.0.1:3400","http://docs.localhost:3400","http://docs.acme.test:3400","http://docs.acme.com:3400"]
MARKDROP_DOCS_CORS_ORIGINS=["http://docs.localhost:3400"]

MARKDROP_AUTH_SECRET=docs-media-local-auth-secret
MARKDROP_ADMIN_SECRET=docs-media-local-admin-secret
MARKDROP_ADMIN_USERNAME=admin
MARKDROP_ADMIN_PASSWORD=docs-media-local-admin
MARKDROP_INTERNAL_SECRET=docs-media-local-internal-secret
MARKDROP_IP_HASH_SALT=docs-media-local-salt
MARKDROP_DOC_REF_SECRET=docs-media-local-docref

# Artifacts: the fake R2 lives inside run_api.py (/__fakes3/<key>); these values only make the
# app consider artifacts "configured". The endpoint is a dead loopback path, so even an
# un-patched boto3 call could never reach a real bucket.
MARKDROP_R2_ACCOUNT_ID=local-fake
MARKDROP_R2_ACCESS_KEY_ID=local-fake
MARKDROP_R2_SECRET_ACCESS_KEY=local-fake
MARKDROP_R2_BUCKET=local-fake
MARKDROP_R2_ENDPOINT=http://127.0.0.1:9/never
MARKDROP_ARTIFACT_ORIGIN=http://127.0.0.1:8787
MARKDROP_ARTIFACT_SIGNING_KEY=docs-media-local-artifact-key

# What customers point DNS at (production sets edge.markdrop.in; the docs say so).
MARKDROP_CUSTOM_DOMAIN_CNAME_TARGET=edge.markdrop.in

MARKDROP_FFPROBE_PATH=/opt/homebrew/bin/ffprobe
MARKDROP_FFMPEG_PATH=/opt/homebrew/bin/ffmpeg

# Nothing leaves this machine.
MARKDROP_EMAIL_TRANSPORT=console
MARKDROP_RESEND_API_KEY=
MARKDROP_EMAIL_WORKER_ENABLED=false
MARKDROP_PAGE_REVALIDATE_ENABLED=false
MARKDROP_BACKGROUND_WORKERS_ENABLED=false
MARKDROP_DOMAIN_RECHECK_ENABLED=false
MARKDROP_ANALYTICS_DIGEST_ENABLED=false
MARKDROP_GOOGLE_CLIENT_ID=
MARKDROP_GOOGLE_CLIENT_SECRET=
MARKDROP_VERCEL_API_TOKEN=
MARKDROP_VERCEL_PROJECT_ID=
MARKDROP_CF_TURN_KEY_ID=
MARKDROP_CF_TURN_API_TOKEN=
MARKDROP_POSTHOG_PROJECT_ID=
MARKDROP_POSTHOG_PERSONAL_API_KEY=
MARKDROP_ANTHROPIC_API_KEY=
MARKDROP_GEOIP_DB_PATH=
MARKDROP_RATE_LIMIT_CREATE=10000/minute
MARKDROP_RATE_LIMIT_READ=100000/minute
